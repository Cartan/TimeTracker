<Window x:Class="TimeTracker.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TimeTracker" Height="760" Width="1120" MinHeight="620" MinWidth="900"
        Background="#F1F5F9" Loaded="Window_Loaded" Closed="Window_Closed">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="22" CornerRadius="12" Background="White">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="RefreshButton" Content="Refresh" Padding="16,8" Margin="0,0,10,0"
                            Click="RefreshButton_Click" IsEnabled="False" />
                    <Button x:Name="SignInButton" Content="Sign in" Padding="16,8" Margin="0,0,10,0"
                            Click="SignInButton_Click" IsEnabled="False" />
                    <Button x:Name="SignOutButton" Content="Sign out" Padding="16,8"
                            Click="SignOutButton_Click" IsEnabled="False" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="TimeTracker" FontSize="26" FontWeight="SemiBold" Foreground="#0F172A" />
                    <TextBlock x:Name="StatusText" Margin="0,4,0,0" Foreground="#64748B"
                               Text="Loading configuration..." TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Padding="22" CornerRadius="12" Background="White">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                    <TextBlock Text="Track time" FontSize="20" FontWeight="SemiBold" Foreground="#0F172A" />
                    <TextBlock Text="Choose a project to start a new session." Margin="0,8,0,18"
                               Foreground="#64748B" TextWrapping="Wrap" />
                    <TextBlock Text="Project" FontWeight="Medium" Foreground="#334155" />
                    <ComboBox x:Name="ProjectComboBox" Margin="0,7,0,18" Padding="8"
                              DisplayMemberPath="DisplayName" SelectionChanged="ProjectComboBox_SelectionChanged"
                              IsEnabled="False" />
                    <Button x:Name="StartButton" Content="Start timer" Padding="12,10" Margin="0,0,0,10"
                            Background="#2563EB" Foreground="White" BorderThickness="0"
                            Click="StartButton_Click" IsEnabled="False" />
                    <Button x:Name="StopButton" Content="Stop current timer" Padding="12,10"
                            Background="#E2E8F0" Foreground="#0F172A" BorderThickness="0"
                            Click="StopButton_Click" IsEnabled="False" />
                    <Separator Margin="0,24,0,20" />
                    <TextBlock Text="Customers and projects" FontSize="20" FontWeight="SemiBold"
                               Foreground="#0F172A" />
                    <TextBlock Text="Add customers and projects to make them available for time tracking."
                               Margin="0,8,0,14" Foreground="#64748B" TextWrapping="Wrap" />
                    <TextBox x:Name="CustomerNameTextBox" Padding="8" Margin="0,0,0,8"
                             TextChanged="CreateInput_TextChanged" />
                    <Button x:Name="AddCustomerButton" Content="Add customer" Padding="12,8" Margin="0,0,0,16"
                            Click="AddCustomerButton_Click" IsEnabled="False" />
                    <TextBox x:Name="ProjectNameTextBox" Padding="8" Margin="0,0,0,8"
                             TextChanged="CreateInput_TextChanged" />
                    <ComboBox x:Name="CustomerComboBox" Padding="8" Margin="0,0,0,8"
                              DisplayMemberPath="Name" SelectionChanged="CustomerComboBox_SelectionChanged"
                              IsEnabled="False" />
                    <Button x:Name="AddProjectButton" Content="Add project" Padding="12,8"
                            Click="AddProjectButton_Click" IsEnabled="False" />
                    <Separator Margin="0,24,0,20" />
                    <TextBlock Text="Current session" FontWeight="SemiBold" Foreground="#334155" />
                    <TextBlock x:Name="CurrentSessionText" Margin="0,10,0,2" FontSize="16"
                               FontWeight="Medium" Foreground="#0F172A" Text="Sign in to load your timer."
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="ElapsedText" FontSize="28" FontWeight="SemiBold"
                               Foreground="#2563EB" Text="--:--:--" />
                    <TextBlock x:Name="CustomersText" Margin="0,20,0,0" Foreground="#64748B" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="2" Padding="22" CornerRadius="12" Background="White">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                        <TextBlock Text="Recent time entries" FontSize="20" FontWeight="SemiBold"
                                   Foreground="#0F172A" />
                        <TextBlock Text="Times are shown in your local time zone." Margin="0,5,0,0"
                                   Foreground="#64748B" />
                    </StackPanel>
                    <DataGrid x:Name="EntriesGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              Background="White" BorderThickness="0" RowHeaderWidth="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Project" Binding="{Binding ProjectName}" Width="2*" />
                            <DataGridTextColumn Header="Started"
                                                Binding="{Binding StartTime, StringFormat={}{0:yyyy-MM-dd HH:mm}}"
                                                Width="1.3*" />
                            <DataGridTextColumn Header="Ended"
                                                Binding="{Binding EndTime, StringFormat={}{0:yyyy-MM-dd HH:mm}}"
                                                Width="1.3*" />
                            <DataGridTextColumn Header="Minutes"
                                                Binding="{Binding DurationMinutes, StringFormat={}{0:N0}}"
                                                Width="0.8*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>

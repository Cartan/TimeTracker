<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.0" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="9.0.21" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="TimeTracker.Tests\**\*.cs" />
    <Content Remove="TimeTracker.Tests\**\*" />
    <EmbeddedResource Remove="TimeTracker.Tests\**\*" />
    <None Remove="TimeTracker.Tests\**\*" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="TimeTracker.Wpf\**\*.cs" />
    <Content Remove="TimeTracker.Wpf\**\*" />
    <EmbeddedResource Remove="TimeTracker.Wpf\**\*" />
    <None Remove="TimeTracker.Wpf\**\*" />
  </ItemGroup>

</Project>

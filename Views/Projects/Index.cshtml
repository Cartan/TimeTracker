@model IEnumerable<TimeTracker.Models.Project>

@{
    ViewData["Title"] = "Projects";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Projects</h2>
    <a asp-action="Create" class="btn btn-primary">Add project</a>
</div>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Customer</th>
            <th>Project</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var project in Model)
        {
            <tr>
                <td>@project.Customer.Name</td>
                <td>@project.Name</td>
                <td class="text-end">
                    <form asp-action="Delete" asp-route-id="@project.Id" method="post" class="d-inline"
                          onsubmit="return confirm('Delete this project and all of its time entries?');">
                        <button type="submit" class="btn btn-outline-danger btn-sm">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

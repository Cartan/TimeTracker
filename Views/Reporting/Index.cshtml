@model TimeTracker.ViewModels.ReportingViewModel

@{
    ViewData["Title"] = "Reporting";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2>Reporting</h2>
        <p class="text-muted mb-0">All tracked time, grouped by customer and project.</p>
    </div>
    <a asp-action="Excel" class="btn btn-outline-primary">Download Excel</a>
</div>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Customer</th>
            <th>Project</th>
            <th class="text-end">Hours</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var project in Model.Projects)
        {
            <tr>
                <td>@project.CustomerName</td>
                <td>@project.ProjectName</td>
                <td class="text-end">@project.Hours.ToString("N2")</td>
            </tr>
        }
        @if (Model.Projects.Count == 0)
        {
            <tr>
                <td colspan="3" class="text-muted">No projects to report yet.</td>
            </tr>
        }
    </tbody>
    <tfoot>
        <tr class="fw-bold">
            <td colspan="2">Total</td>
            <td class="text-end">@Model.TotalHours.ToString("N2")</td>
        </tr>
    </tfoot>
</table>
